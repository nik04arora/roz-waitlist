---
import type { CollectionEntry } from 'astro:content';
import { articlePath, topicLabel } from '../lib/content';

interface Props {
  post: CollectionEntry<'learn'>;
}

const { post } = Astro.props;
---

<article class="article-card">
  <div class="card-meta">
    <span>{topicLabel(post.data.topics[0])}</span>
    {post.data.status === 'draft' && <span class="draft-badge">Draft preview</span>}
  </div>
  <h2><a href={articlePath(post.id)}>{post.data.title}</a></h2>
  <p>{post.data.summary}</p>
  <a class="text-link" href={articlePath(post.id)}>Read the guide <span aria-hidden="true">→</span></a>
</article>
