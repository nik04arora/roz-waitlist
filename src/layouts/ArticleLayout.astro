---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { articlePath, topicLabel } from '../lib/content';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: CollectionEntry<'learn'>;
  author: CollectionEntry<'authors'>;
  reviewer?: CollectionEntry<'authors'>;
  headings: Heading[];
  related: CollectionEntry<'learn'>[];
}

const { post, author, reviewer, headings, related } = Astro.props;
const path = articlePath(post.id);
const canonical = new URL(path, Astro.site).toString();
const visibleHeadings = headings.filter((heading) => heading.depth === 2);
const dateFormat = new Intl.DateTimeFormat('en-IN', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC'
});
const displayName = (person: CollectionEntry<'authors'>) =>
  [person.data.honorificPrefix, person.data.name].filter(Boolean).join(' ');

const personSchema = (person: CollectionEntry<'authors'>) => ({
  '@type': person.data.schemaType,
  name: person.data.name,
  url: new URL(`/learn/authors/${person.id}/`, Astro.site).toString(),
  ...(person.data.schemaType === 'Person' ? { jobTitle: person.data.role } : {}),
  ...(person.data.honorificPrefix ? { honorificPrefix: person.data.honorificPrefix } : {}),
  ...(person.data.profileUrl ? { sameAs: person.data.profileUrl } : {})
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${canonical}#article`,
      headline: post.data.title,
      description: post.data.description,
      abstract: post.data.summary,
      image: post.data.articleImages.map((image) => new URL(image, Astro.site).toString()),
      datePublished: post.data.publishedAt.toISOString(),
      dateModified: post.data.updatedAt.toISOString(),
      inLanguage: 'en-IN',
      mainEntityOfPage: canonical,
      isPartOf: { '@id': 'https://www.rozinvest.com/#website' },
      author: personSchema(author),
      ...(reviewer ? { reviewedBy: personSchema(reviewer) } : {}),
      citation: post.data.sources.map((source) => source.url),
      keywords: post.data.topics.map(topicLabel),
      publisher: { '@id': 'https://www.rozinvest.com/#organization' }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.rozinvest.com/' },
        { '@type': 'ListItem', position: 2, name: 'Learn', item: 'https://www.rozinvest.com/learn/' },
        { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical }
      ]
    },
    {
      '@type': 'FAQPage',
      mainEntity: post.data.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer }
      }))
    }
  ]
};
---

<BaseLayout
  title={`${post.data.title} | Roz Invest`}
  description={post.data.description}
  canonicalPath={path}
  image={post.data.socialImage}
  imageAlt={post.data.socialImageAlt}
  robots={post.data.status === 'draft' ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'}
  type="article"
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  jsonLd={jsonLd}
>
  <div class="article-shell">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span>
      <a href="/learn/">Learn</a><span aria-hidden="true">/</span>
      <span aria-current="page">{post.data.title}</span>
    </nav>

    <header class="article-header">
      <div class="card-meta">
        <a href={`/learn/topics/${post.data.topics[0]}/`}>{topicLabel(post.data.topics[0])}</a>
        {post.data.status === 'draft' && <span class="draft-badge">Draft preview</span>}
      </div>
      <h1>{post.data.title}</h1>
      <p class="article-summary">{post.data.summary}</p>
      <dl class="byline">
        <div><dt>Written by</dt><dd><a href={`/learn/authors/${author.id}/`}>{displayName(author)}</a></dd></div>
        {reviewer && <div><dt>Reviewed by</dt><dd><a href={`/learn/authors/${reviewer.id}/`}>{displayName(reviewer)}</a></dd></div>}
        {post.data.reviewedAt && <div><dt>Reviewed</dt><dd><time datetime={post.data.reviewedAt.toISOString()}>{dateFormat.format(post.data.reviewedAt)}</time></dd></div>}
        <div><dt>Updated</dt><dd><time datetime={post.data.updatedAt.toISOString()}>{dateFormat.format(post.data.updatedAt)}</time></dd></div>
      </dl>
    </header>

    {post.data.hero.type === 'image' ? (
      <figure class="article-hero article-hero--image">
        <img src={post.data.hero.src} alt={post.data.hero.alt} width="1200" height="630" />
      </figure>
    ) : (
      <figure class="article-hero article-hero--quote">
        <blockquote>“{post.data.hero.quote}”</blockquote>
        <figcaption>— {post.data.hero.attribution}</figcaption>
      </figure>
    )}

    <div class="article-grid">
      {visibleHeadings.length > 1 && (
        <aside class="toc" aria-labelledby="toc-title">
          <h2 id="toc-title">In this guide</h2>
          <ol>
            {visibleHeadings.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
          </ol>
        </aside>
      )}
      <article class="prose">
        <div class="key-answer">
          <p class="eyebrow">The short answer</p>
          <p>{post.data.summary}</p>
        </div>
        <slot />

        <section class="faq" aria-labelledby="faq-title">
          <h2 id="faq-title">Frequently asked questions</h2>
          {post.data.faqs.map((faq) => (
            <div class="faq-item">
              <h3>{faq.question}</h3>
              <p>{faq.answer}</p>
            </div>
          ))}
        </section>

        <section class="sources" aria-labelledby="sources-title">
          <h2 id="sources-title">Sources</h2>
          <ol>
            {post.data.sources.map((source) => (
              <li><a href={source.url} rel="external">{source.title}</a> — {source.publisher}</li>
            ))}
          </ol>
        </section>

        <aside class="article-cta" aria-label="Roz Invest waitlist">
          <div>
            <p class="eyebrow">Invest with clarity</p>
            <h2>Ready for a simpler way to invest?</h2>
            <p>{post.data.cta.description}</p>
          </div>
          <a class="article-cta__button" href={post.data.cta.href}>{post.data.cta.label}</a>
        </aside>

        <aside class="disclosure" aria-label="Important information">
          <strong>Important:</strong> This content is for educational and informational purposes only. It is not investment advice or a recommendation to buy or sell any mutual fund scheme. Mutual fund investments are subject to market risks. Read all scheme-related documents carefully.
        </aside>
      </article>
    </div>

    {related.length > 0 && (
      <section class="related" aria-labelledby="related-title">
        <h2 id="related-title">Keep learning</h2>
        <div class="related-grid">
          {related.map((item) => (
            <a href={articlePath(item.id)}>
              <span>{topicLabel(item.data.topics[0])}</span>
              <strong>{item.data.title}</strong>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
